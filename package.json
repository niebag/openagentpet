{
  "name": "openagentpet",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "openagentpet": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && node dist/src/cli.js spawn --session-id local-development",
    "start": "npm run build && electron dist/src/electron.js",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "npm run build && node --test dist/test/*.test.js",
    "test:smoke": "npm run build && electron dist/test/electron-smoke.js",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "electron": "^43.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.0"
  }
}
