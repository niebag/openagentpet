{
  "name": "openagentpet",
  "productName": "OpenAgentPet",
  "version": "1.2.0",
  "description": "A floating Pet for local Claude Code sessions",
  "type": "module",
  "bin": {
    "openagentpet": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "public",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "claude-code",
    "electron",
    "macos",
    "windows",
    "desktop-companion"
  ],
  "author": "Niels Baggerman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niebag/openagentpet.git"
  },
  "bugs": "https://github.com/niebag/openagentpet/issues",
  "homepage": "https://github.com/niebag/openagentpet#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && node dist/src/cli.js spawn --session-id local-development",
    "start": "npm run build && electron dist/src/electron.js",
    "test": "npm run test:unit && npm run test:smoke",
    "test:artifact": "node test/artifact-smoke.mjs",
    "test:release": "npm run test:artifact && npm run test:unit && claude plugin validate .",
    "test:unit": "npm run build && node --test dist/test/*.test.js",
    "test:smoke": "npm run build && electron dist/test/electron-smoke.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "electron": "^43.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.0"
  }
}
